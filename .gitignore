# challenge data and run artefacts stay local (notes, reports and solution.py can be committed)
challenges/*/dataset/
challenges/*/working/
__pycache__/
*.pyc
challenges/toy_support/

# competitor/raw solutions supplied to /eris-learn stay local; digests are committed
corpus/*/solutions/
challenges/*/kaggle_kernel/
challenges/*/kaggle_out/
challenges/*/kaggle_data/

# two_puffs: large intermediates and local run dirs
challenges/two_puffs/dataset/
challenges/two_puffs/work/*.csv
challenges/two_puffs/work/*.npy
challenges/two_puffs/work/*.npz
challenges/two_puffs/work/*.pkl
challenges/two_puffs/run*/
